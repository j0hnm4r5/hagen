{
	"name": "hagen",
	"version": "3.1.0",
	"description": "A colorful logger for JS in Node and the Browser",
	"author": "John Mars <john@hellomars.dev> (http://hellomars.dev)",
	"repository": "github:j0hnm4r5/hagen",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"logger",
		"node",
		"browser",
		"console",
		"reporter",
		"print",
		"colorful",
		"esm",
		"elegant",
		"beautiful"
	],
	"engines": {
		"node": ">=20.0.0"
	},
	"files": [
		"dist",
		"src"
	],
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"dev": "tsup --watch",
		"build": "tsup && mv dist/index.d.ts dist/index.d.mts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"lint:check": "eslint .",
		"lint:fix": "eslint . --fix",
		"format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.md\"",
		"format:fix": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.md\"",
		"type:check": "tsc --noEmit",
		"pkg:check": "attw --pack . --profile esm-only --no-summary",
		"size:check": "size-limit",
		"clean": "rm -rf dist coverage .vitest",
		"prepare": "husky",
		"prepublishOnly": "npm run lint && npm run type-check && npm run test && npm run build",
		"visualize:node": "tsx src/test/visualize/node/index.ts",
		"visualize:node:no-color": "NO_COLOR=true npm run visualize:node",
		"visualize:browser": "vite --config src/test/visualize/browser/vite.config.ts"
	},
	"dependencies": {
		"ansis": "^4.2.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.17.4",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@eslint/js": "^9.39.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.2",
		"@size-limit/preset-small-lib": "^12.0.0",
		"@types/eslint__js": "^8.42.3",
		"@types/node": "^25.0.1",
		"@vitest/coverage-v8": "^4.0.15",
		"@vitest/ui": "^4.0.15",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.4",
		"eslint-plugin-unicorn": "^62.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"prettier": "^3.7.4",
		"semantic-release": "^25.0.2",
		"size-limit": "^12.0.0",
		"strip-ansi": "^7.1.2",
		"tsup": "^8.4.0",
		"tsx": "^4.19.3",
		"typescript": "^5.8.2",
		"typescript-eslint": "^8.48.1",
		"vite": "^6.2.2",
		"vitest": "^4.0.15"
	},
	"lint-staged": {
		"*.ts": [
			"eslint --fix",
			"prettier --write",
			"bash -c 'tsc --noEmit'"
		],
		"*.{json,md}": [
			"prettier --write"
		]
	},
	"size-limit": [
		{
			"path": "dist/index.mjs",
			"limit": "5 KB"
		}
	]
}
